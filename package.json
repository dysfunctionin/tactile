{
  "name": "tactile",
  "version": "1.2.0-alpha.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "scripts": {
    "git:install": "node scripts/release/install-git-build.mjs",
    "version:sync": "node scripts/release/sync-version.mjs",
    "version:check": "node scripts/release/sync-version.mjs --check",
    "predev": "npm run version:sync && npm run version:check",
    "dev": "npm run marketplace:build && vite",
    "prebuild": "npm run version:sync && npm run version:check",
    "build": "npm run marketplace:build && vite build && node scripts/prepare-sites-build.mjs && node scripts/check-bundle-budget.mjs",
    "marketplace:build": "node scripts/build-marketplace.mjs",
    "preview": "vite preview",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "pretests:all": "npm run build",
    "tests:all": "node tests/harness/all.mjs",
    "test:unit": "node tests/harness/run.mjs --types unit,compatibility node --test \"tests/cases/**/*.test.mjs\"",
    "test:coverage": "c8 --clean --all --reporter=text-summary --reporter=json-summary --report-dir=coverage node --test \"tests/cases/**/*.test.mjs\"",
    "test:platform": "node tests/harness/run.mjs --types platform node --test \"tests/cases/**/*.test.mjs\"",
    "test:sites": "node tests/harness/run.mjs --types sites node --test \"tests/cases/**/*.test.mjs\"",
    "test:performance": "node tests/harness/run.mjs --types performance node --test \"tests/cases/**/*.test.mjs\"",
    "test:e2e": "node tests/harness/run.mjs npx playwright test --config config/playwright/e2e.config.mjs",
    "test:report": "node tests/harness/report.mjs",
    "test:steps": "node tests/harness/report.mjs --steps",
    "test:trend": "node tests/harness/report.mjs --trend",
    "test:failures": "node tests/harness/report.mjs --failed",
    "dashboard": "node test-dashboard/serve.mjs",
    "dashboard:sync-themes": "node test-dashboard/scripts/sync-themes.mjs",
    "verify": "npm run version:check && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:platform && npm run test:performance && npm run test:e2e && npm run build && npm run test:sites"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/lilex": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tabler/icons-react": "^3.46.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "c8": "^12.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.4.3"
  }
}
